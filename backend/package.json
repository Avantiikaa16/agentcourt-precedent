{
  "name": "agentcourt-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p . --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node --env-file=.env dist/server.js",
    "start:render": "node scripts/write-guild-auth.mjs && node dist/server.js",
    "seed": "node scripts/seed.mjs",
    "rocketride:deploy": "node scripts/deploy-rocketride-pipeline.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@laserdata/laser-sdk": "^0.0.1",
    "apache-iggy": "^0.8.0",
    "fastify": "^5.0.0",
    "redis": "^6.2.0",
    "rocketride": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
